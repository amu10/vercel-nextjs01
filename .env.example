# ---------------------------------------------------------------------------
# 本地开发：复制本文件为 .env.local，并填入真实的连接串。
# 在 Vercel 上：这些变量由 Neon / Vercel Storage 集成自动注入，无需手动填写。
# ---------------------------------------------------------------------------

# Neon 原生集成（Vercel 当前推荐方案）注入的就是这个，代码优先读它
DATABASE_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# 旧版 Vercel Postgres 集成注入的是 POSTGRES_URL，代码同样认（作为兜底）
# POSTGRES_URL="postgres://user:password@host:5432/verceldb?sslmode=require"

# 需要非池化连接（例如跑迁移）时 Neon 还会给这个，本项目用不到
# DATABASE_URL_UNPOOLED=""
